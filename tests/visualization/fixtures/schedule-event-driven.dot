digraph "event-driven-schedule" {
labelloc=top;
fontsize=20;
rankdir=TB;
splines=ortho;
node [shape=box, style=rounded];
callNurse [label="callNurse\ncall: http\nPOST https://hospital.example.com/api/v1/notify", shape=box, style=rounded];
end [label="end", shape=doublecircle, style=filled, fillcolor=lightcoral];
start [label="start", shape=circle, style=filled, fillcolor=lightgreen];
callNurse -> end;
start -> callNurse;
}
