digraph "run-shell-with-stdin-and-arguments" {
labelloc=top;
fontsize=20;
rankdir=TB;
splines=ortho;
node [shape=box, style=rounded];
end [label="end", shape=doublecircle, style=filled, fillcolor=lightcoral];
runShell [label="runShell\nrun", shape=box, style=rounded];
setInput [label="setInput\nset", shape=box, style=rounded];
start [label="start", shape=circle, style=filled, fillcolor=lightgreen];
runShell -> end;
setInput -> runShell;
start -> setInput;
}
