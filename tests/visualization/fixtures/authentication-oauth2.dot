digraph "oauth2-authentication" {
labelloc=top;
fontsize=20;
rankdir=TB;
splines=ortho;
node [shape=box, style=rounded];
end [label="end", shape=doublecircle, style=filled, fillcolor=lightcoral];
getPet [label="getPet\ncall: http\nGET {'uri': 'https://petstore.swagger.io/v2/pet/{petId}', 'authentication': {'oauth2': {'authority': 'http://keycloak/realms/fake-authority', 'endpoints': {'token': '/auth/token', 'introspection': '/auth/introspect'}, 'grant': 'client_credentials', 'client': {'id': 'workflow-runtime-id', 'secret': 'workflow-runtime-secret'}}}}", shape=box, style=rounded];
petId [label="Input: petId", shape=box, style=filled, fillcolor=lightyellow];
start [label="start", shape=circle, style=filled, fillcolor=lightgreen];
getPet -> end;
petId -> getPet [style=dashed, xlabel="input"];
start -> getPet;
}
