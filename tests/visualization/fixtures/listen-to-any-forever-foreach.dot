digraph "listen-to-any-while-foreach" {
labelloc=top;
fontsize=20;
rankdir=TB;
splines=ortho;
node [shape=box, style=rounded];
end [label="end", shape=doublecircle, style=filled, fillcolor=lightcoral];
listenToGossips [label="listenToGossips\nlisten", shape=box, style=rounded];
start [label="start", shape=circle, style=filled, fillcolor=lightgreen];
listenToGossips -> end;
start -> listenToGossips;
}
