digraph "mcp-example" {
labelloc=top;
fontsize=20;
rankdir=TB;
splines=ortho;
node [shape=box, style=rounded];
end [label="end", shape=doublecircle, style=filled, fillcolor=lightcoral];
publishMessageToSlack [label="publishMessageToSlack", shape=box, style=rounded];
start [label="start", shape=circle, style=filled, fillcolor=lightgreen];
publishMessageToSlack -> end;
start -> publishMessageToSlack;
}
