digraph "raise-not-implemented" {
labelloc=top;
fontsize=20;
rankdir=TB;
splines=ortho;
node [shape=box, style=rounded];
end [label="end", shape=doublecircle, style=filled, fillcolor=lightcoral];
notImplemented [label="notImplemented\nraise", shape=box, style=rounded];
start [label="start", shape=circle, style=filled, fillcolor=lightgreen];
notImplemented -> end;
start -> notImplemented;
}
