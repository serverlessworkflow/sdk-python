digraph "sample-workflow" {
labelloc=top;
fontsize=20;
rankdir=TB;
splines=ortho;
node [shape=box, style=rounded];
callHttp [label="callHttp\ncall: http\nGET {'uri': 'https://fake.com/sample'}", shape=box, style=rounded];
end [label="end", shape=doublecircle, style=filled, fillcolor=lightcoral];
start [label="start", shape=circle, style=filled, fillcolor=lightgreen];
callHttp -> end;
start -> callHttp;
}
