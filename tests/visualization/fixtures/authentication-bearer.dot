digraph "bearer-auth-uri-format" {
labelloc=top;
fontsize=20;
rankdir=TB;
splines=ortho;
node [shape=box, style=rounded];
end [label="end", shape=doublecircle, style=filled, fillcolor=lightcoral];
getPet [label="getPet\ncall: http\nGET {'uri': 'https://petstore.swagger.io/v2/pet/1', 'authentication': {'bearer': {'token': '${ .token }'}}}", shape=box, style=rounded];
start [label="start", shape=circle, style=filled, fillcolor=lightgreen];
getPet -> end;
start -> getPet;
}
